<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action -->
    <record id="travel_package_action" model="ir.actions.act_window">
        <field name="name">Travel Packages</field>
        <field name="res_model">travel.package</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tree/List View -->
    <record id="view_travel_package_list" model="ir.ui.view">
        <field name="name">travel.package.list</field>
        <field name="model">travel.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location"/>
                <field name="price"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_featured"/>
            </list>
        </field>
    </record>

   <!-- Form View -->
    <record id="view_travel_package_form" model="ir.ui.view">
        <field name="name">travel.package.form</field>
        <field name="model">travel.package</field>
        <field name="arch" type="xml">
            <form string="Travel Package">
                <sheet>
                    <widget name="web_ribbon" title="Active" bg_color="bg-warning" invisible="not is_featured"/>

                    <div class="oe_title">
                        <label for="name" string="Package Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Summer in Santorini"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="package_name"/>
                            <field name="location" placeholder="e.g. Greece"/>
                            <field name="price"/>
                            <field name="is_dropdown"/>
                             <field name="is_featured"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                             <field name="image" widget="image" class="my_large_image"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Write detailed package description here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
