<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="single_card" name="single Card">
        <section class="s_travelog_cards pt-5 pb-5">
            <t t-set="packages" t-value="request.env['travel.package'].sudo().search([])"/>

            <div class="container">
                <div class="row align-items-center mb-5">
                    <div class="col-lg-6 order-lg-2">
                        <h2 class="travelog_title mb-3">Amazing places to enjoy your travel</h2>
                        <p class="travelog_subtitle text-muted">
                            Etiam facilisis, sapien quis porta dignissim, orci nisi pharetra dui...
                        </p>
                        <a href="/packages" class="btn btn-primary travelog_explore_btn mt-3">Explore</a>
                    </div>
                    <div class="col-lg-6 order-lg-1">
                        <div class="travelog_hero_image">
                            <img src="/theme_travelog/static/src/img/banner/hero_bg.jpg"
                                 alt="Travel" class="img-fluid rounded"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>