<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="s_travelog_hero" name="Travelog Hero">
        <section class="s_travelog_hero o_cc o_cc1 pt96 pb96" data-snippet="s_travelog_hero" data-name="Travelog Hero">
            <div class="o_we_bg_filter bg-black-50"></div>
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 o_colored_level pt32 pb32" data-name="Content">
                        <span class="s_travelog_hero_badge d-inline-block mb-3 px-3 py-2 rounded-pill bg-white bg-opacity-25 text-black small fw-bold">
                            ADVENTURE AWAITS
                        </span>
                        <h1 class="s_travelog_hero_title display-3 fw-bold text-white mb-4" data-name="Title">
                            Discover Your Next Journey
                        </h1>
                        <p class="s_travelog_hero_subtitle lead text-white mb-4 pe-lg-5 d-none d-md-block" data-name="Subtitle">
                            Explore breathtaking destinations, create unforgettable memories, and share your travel stories with the world.
                        </p>
                        <div class="s_travelog_hero_buttons d-flex flex-wrap gap-3 mb-4">
                            <a href="/blog" class="btn btn-primary btn-lg rounded-pill px-4 py-3">
                                Start Exploring
                            </a>

<!--                            Destination Button-->
<!--                            <a href="#" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3">-->
<!--                                View Destinations-->
<!--                            </a>-->
                        </div>
                        <div class="s_travelog_hero_stats d-flex flex-wrap gap-4 mt-5">
                            <div class="s_travelog_hero_stat">
                                <h3 class="h2 fw-bold text-white mb-0" data-counter="250">0</h3>
                                <p class="text-white-50 mb-0 small">Destinations</p>
                            </div>
                            <div class="s_travelog_hero_stat">
                                <h3 class="h2 fw-bold text-white mb-0" data-counter="10000">0</h3>
                                <p class="text-white-50 mb-0 small">Travelers</p>
                            </div>
                            <div class="s_travelog_hero_stat">
                                <h3 class="h2 fw-bold text-white mb-0" data-counter="50">0</h3>
                                <p class="text-white-50 mb-0 small">Countries</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6" data-name="Image Gallery">
                        <div class="s_travelog_hero_gallery position-relative">
                            <div class="s_travelog_hero_card s_travelog_hero_card_1 position-absolute">
                                <img src="/theme_travelog/static/src/img/banner/Santorini Greece.jpg" alt="Travel Destination 1" class="img-fluid rounded-4 shadow-lg"/>
                                <div class="s_travelog_hero_card_overlay position-absolute bottom-0 start-0 w-100 p-3 text-white">
                                    <h5 class="mb-1 fw-bold">Santorini, Greece</h5>
                                    <p class="mb-0 small opacity-75">Mediterranean Paradise</p>
                                </div>
                            </div>
                            <div class="s_travelog_hero_card s_travelog_hero_card_2 position-absolute">
                                <img src="/theme_travelog/static/src/img/banner/Bali-Indonesia.jpg" alt="Travel Destination 2" class="img-fluid rounded-4 shadow-lg"/>
                                <div class="s_travelog_hero_card_overlay position-absolute bottom-0 start-0 w-100 p-3 text-white">
                                    <h5 class="mb-1 fw-bold">Bali, Indonesia</h5>
                                    <p class="mb-0 small opacity-75">Tropical Wonder</p>
                                </div>
                            </div>
                            <div class="s_travelog_hero_card s_travelog_hero_card_3 position-absolute">
                                <img src="/theme_travelog/static/src/img/banner/Iceland.jpg" alt="Travel Destination 3" class="img-fluid rounded-4 shadow"/>
                                <div class="s_travelog_hero_card_overlay position-absolute bottom-0 start-0 w-100 p-3 text-white">
                                    <h5 class="mb-1 fw-bold">Iceland</h5>
                                    <p class="mb-0 small opacity-75">Northern Lights</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scroll indicator -->
            <div class="s_travelog_hero_scroll position-absolute bottom-0 start-50 translate-middle-x mb-4">
                <div class="text-center">
                    <p class="text-white small mb-2 opacity-75">Scroll to explore</p>
                    <div class="s_travelog_hero_scroll_icon">
                        <i class="fa fa-chevron-down text-white"></i>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
