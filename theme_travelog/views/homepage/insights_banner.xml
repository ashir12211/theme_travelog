<odoo>
    <data>
        <!-- Insights Banner Snippet -->
        <template id="s_insights_banner" name="Insights Banner">
            <section class="s_insights_banner py-5" data-name="Insights Banner">
                <div class="container">
                    <div class="row align-items-center">
                        <!-- Cards Section -->
                        <div class="col-lg-6 mb-4 mb-lg-0">
                            <div class="insights-cards-container">
                                <!-- Card 1 - Green -->
                                <div class="insight-card card-green" data-aos="fade-right" data-aos-delay="100">
                                    <div class="card-image">
                                        <img src="/theme_travelog/static/src/img/banner/Bali-Indonesia.jpg" 
                                             alt="Bali" 
                                             class="img-fluid"/>
                                    </div>
                                    <div class="card-icon">
                                        <i class="fa fa-instagram"></i>
                                    </div>
                                </div>
                                
                                <!-- Card 2 - Orange -->
                                <div class="insight-card card-orange" data-aos="fade-right" data-aos-delay="200">
                                    <div class="card-image">
                                        <img src="/theme_travelog/static/src/img/banner/Santorini Greece.jpg" 
                                             alt="Santorini" 
                                             class="img-fluid"/>
                                    </div>
                                    <div class="card-icon">
                                        <i class="fa fa-instagram"></i>
                                    </div>
                                </div>
                                
                                <!-- Card 3 - Blue -->
                                <div class="insight-card card-blue" data-aos="fade-right" data-aos-delay="300">
                                    <div class="card-image">
                                        <img src="/theme_travelog/static/src/img/banner/Iceland.jpg" 
                                             alt="Iceland" 
                                             class="img-fluid"/>
                                    </div>
                                    <div class="card-icon">
                                        <i class="fa fa-instagram"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Text Section -->
                        <div class="col-lg-6">
                            <div class="insights-content" data-aos="fade-left" data-aos-delay="400">
                                <h2 class="insights-title mb-3">
                                    Insights, Stories &amp; Expert Tips
                                </h2>
                                <p class="insights-subtitle mb-4">
                                    Your hub for fresh ideas and useful knowledge.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </template>
    </data>
</odoo>
