<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- About Us Hero Section -->
    <template id="s_travelog_about_hero" name="Travelog About Hero">
        <section class="s_travelog_about_hero o_cc o_cc1 pt96 pb96" data-snippet="s_travelog_about_hero" data-name="About Hero">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0">
                        <span class="s_about_badge d-inline-block mb-3 px-4 py-2 rounded-pill text-white small fw-bold"
      style="background-color: #0d6efd;">
                            ABOUT US
                        </span>
                       <h1 class="s_about_title display-3 fw-bold mb-4 text-white">
    Your Journey Begins With Us
</h1>

                       <p class="s_about_description lead mb-4 text-white">
    We are passionate travel experts dedicated to creating unforgettable experiences around the world. With over a decade of expertise, we transform your travel dreams into reality.
</p>

                        <div class="s_about_features">
                            <div class="s_about_feature_item d-flex align-items-start mb-3">
                               <div class="s_about_feature_icon me-3" style="background-color: #0d6efd; border-radius: 8px; padding: 8px;">
    <i class="fa fa-check-circle text-white fa-2x"></i>
</div>

                                <div>
                                    <h5 class="fw-bold mb-1"  style="color: #ffffff;">Expertly Curated</h5>
                                    <p class="mb-0"  style="color: #ffffff;">Every destination handpicked by travel experts</p>
                                </div>
                            </div>
                          <div class="s_about_feature_item d-flex align-items-start mb-3">
    <div class="s_about_feature_icon me-3"
         style="background-color: #0d6efd; padding: 10px; border-radius: 50%; width: 48px; height: 48px; display:flex; justify-content:center; align-items:center;">
        <i class="fa fa-shield text-white fa-lg"></i>
    </div>
                                <div>
                                    <h5 class="fw-bold mb-1"  style="color: #ffffff;">Safe &amp; Secure</h5>
                                    <p class="mb-0"  style="color: #ffffff;">Your safety is our top priority</p>
                                </div>
                            </div>
                            <div class="s_about_feature_item d-flex align-items-start">
                              <div class="s_about_feature_icon me-3"
     style="background-color: #0d6efd; padding: 10px; border-radius: 50%; width: 48px; height: 48px; display:flex; justify-content:center; align-items:center;">
    <i class="fa fa-heart text-white fa-lg"></i>
</div>

                                <div>
                                    <h5 class="fw-bold mb-1"  style="color: #ffffff;">Personalized Service</h5>
                                    <p class="mb-0"  style="color: #ffffff;">Tailored experiences just for you</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="s_about_hero_image">
                            <img src="/theme_travelog/static/src/img/banner/logo.png" alt="About Us" class="img-fluid rounded-4 shadow-lg"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Stats Section -->
    <template id="s_travelog_about_stats" name="Travelog About Stats">
        <section class="s_travelog_about_stats o_cc o_cc2 pt96 pb96" data-snippet="s_travelog_about_stats" data-name="About Stats">
            <div class="container">
                <div class="row text-center">
                    <div class="col-md-3 col-6 mb-4 mb-md-0">
                        <div class="s_stat_card">
                            <div class="s_stat_icon mb-3">
                                <i class="fa fa-globe fa-3x " style="color: #0056b3;"></i>
                            </div>
                            <h2 class="s_stat_number display-4 fw-bold mb-2" data-counter="250">0</h2>
                            <p class="s_stat_label text-muted mb-0">Destinations</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-4 mb-md-0">
                        <div class="s_stat_card">
                            <div class="s_stat_icon mb-3">
                                <i class="fa fa-users fa-3x " style="color: #0056b3;"></i>
                            </div>
                            <h2 class="s_stat_number display-4 fw-bold mb-2" data-counter="10000">0</h2>
                            <p class="s_stat_label text-muted mb-0">Happy Travelers</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="s_stat_card">
                            <div class="s_stat_icon mb-3">
                                <i class="fa fa-trophy fa-3x " style="color: #0056b3;"></i>
                            </div>
                            <h2 class="s_stat_number display-4 fw-bold mb-2" data-counter="50">0</h2>
                            <p class="s_stat_label text-muted mb-0">Awards Won</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="s_stat_card">
                            <div class="s_stat_icon mb-3">
                                <i class="fa fa-star fa-3x " style="color: #0056b3;"></i>
                            </div>
                            <h2 class="s_stat_number display-4 fw-bold mb-2"><span data-counter="15">0</span>+</h2>
                            <p class="s_stat_label text-muted mb-0">Years Experience</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

