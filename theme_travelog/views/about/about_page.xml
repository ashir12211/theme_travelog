    </template>

    <!-- Our Story Section -->
    <template id="s_travelog_about_story" name="Travelog Our Story">
        <section class="s_travelog_about_story o_cc o_cc2 pt96 pb96" data-snippet="s_travelog_about_story" data-name="Our Story">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0">
                        <div class="s_story_images">
                            <div class="s_story_image_main">
                                <img src="/theme_travelog/static/src/img/banner/logo.png" alt="Our Story" class="img-fluid rounded-4 shadow-lg"/>
                            </div>
                            <div class="s_story_image_badge">
                                <div class="s_story_badge_content">
                                    <h3 class="display-5 fw-bold text-white mb-0">15+</h3>
                                    <p class="text-white mb-0">Years of Excellence</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                      <span class="s_story_badge d-inline-block mb-3 px-4 py-2 rounded-pill text-white small fw-bold"
      style="background-color: #0d6efd;">
    OUR STORY
</span>

                        <h2 class="s_story_title display-4 fw-bold mb-4">
                            Crafting Memorable Journeys Since 2009
                        </h2>
                        <p class="s_story_text text-muted mb-4">
                            What started as a small travel agency with a big dream has grown into a trusted name in the travel industry. Our journey began with a simple belief: every traveler deserves an extraordinary experience.
                        </p>
                        <p class="s_story_text text-muted mb-4">
                            Over the years, we've helped thousands of travelers discover the world, from hidden gems to iconic destinations. Our commitment to excellence and personalized service has earned us the trust and loyalty of our clients.
                        </p>
                        <div class="s_story_values">
                            <div class="s_story_value_item d-flex align-items-center mb-3">
                                <i class="fa fa-check-circle me-3 fa-lg" style="color: #0056b3;"></i>
                                <span class="fw-semibold">Personalized Travel Experiences</span>
                            </div>
                            <div class="s_story_value_item d-flex align-items-center mb-3">
                                <i class="fa fa-check-circle me-3 fa-lg" style="color: #0056b3;"></i>
                                <span class="fw-semibold">24/7 Customer Support</span>
                            </div>
                            <div class="s_story_value_item d-flex align-items-center">
                                <i class="fa fa-check-circle me-3 fa-lg" style="color: #0056b3;"></i>
                                <span class="fw-semibold">Best Price Guarantee</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
