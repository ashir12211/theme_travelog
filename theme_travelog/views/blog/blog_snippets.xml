<odoo>
    <data>
        <!-- Blog Hero Banner Snippet -->
        <template id="s_blog_hero_banner" name="Blog Hero Banner">
            <section class="s_blog_hero_banner position-relative overflow-hidden" data-name="Blog Hero">
                <!-- Background Image -->
                <div class="blog-hero-bg position-absolute w-100 h-100" 
                     style="background-image: url('/theme_travelog/static/src/img/banner/hero_bg-3.jpg');">
                </div>
                
                <!-- Overlay -->
                <div class="blog-hero-overlay position-absolute w-100 h-100"></div>
                
                <!-- Content -->
                <div class="container position-relative" style="z-index: 2;">
                    <div class="row justify-content-center text-center">
                        <div class="col-lg-8">
                            <!-- Badge -->
                            <div class="blog-badge mb-4" data-aos="fade-down">
                                <i class="fa fa-book-open me-2"></i>
                                Travel Stories
                            </div>
                            
                            <!-- Title -->
                            <h1 class="blog-hero-title mb-4" data-aos="fade-up" data-aos-delay="100">
                                Discover Amazing<br/>
                                Travel Stories
                            </h1>
                            
                            <!-- Subtitle -->
                            <p class="blog-hero-subtitle mb-5" data-aos="fade-up" data-aos-delay="200">
                                Explore the world through our curated collection of travel experiences,<br/>
                                tips, and destination guides
                            </p>
                            
                            <!-- Search Bar -->
                            <div class="blog-search-wrapper" data-aos="fade-up" data-aos-delay="300">
                                <form action="/blog" method="get" class="blog-search-form">
                                    <div class="input-group">
                                        <span class="input-group-text border-0">
                                            <i class="fa fa-search"></i>
                                        </span>
                                        <input type="text" 
                                               name="search" 
                                               class="form-control border-0" 
                                               placeholder="Search for destinations, tips, guides..."/>
                                        <button type="submit" class="btn btn-primary">
                                            Search
                                        </button>
                                    </div>
                                </form>
                            </div>
                            
                            <!-- Stats -->
                            <div class="blog-stats mt-5" data-aos="fade-up" data-aos-delay="400">
                                <div class="row g-4">
                                    <div class="col-4">
                                        <div class="stat-item">
                                            <h3 class="stat-number">500+</h3>
                                            <p class="stat-label">Articles</p>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="stat-item">
                                            <h3 class="stat-number">50+</h3>
                                            <p class="stat-label">Destinations</p>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="stat-item">
                                            <h3 class="stat-number">10K+</h3>
                                            <p class="stat-label">Readers</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Scroll Indicator -->
                <div class="scroll-indicator" data-aos="fade" data-aos-delay="500">
                    <div class="scroll-mouse">
                        <div class="scroll-wheel"></div>
                    </div>
                    <p class="scroll-text">Scroll to explore</p>
                </div>
            </section>
        </template>

        <!-- Blog Post Grid Snippet -->
        <template id="s_blog_post_grid" name="Blog Post Grid">
            <section class="s_blog_post_grid py-5">
                <div class="container">
                    <!-- Section Header -->
                    <div class="row mb-5">
                        <div class="col-lg-8 mx-auto text-center">
                            <h2 class="section-title mb-3">Latest Travel Stories</h2>
                            <p class="section-subtitle text-muted">
                                Discover inspiring travel stories and expert tips from around the world
                            </p>
                        </div>
                    </div>
                    
                    <!-- Category Filter -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="blog-category-filter text-center">
                                <button class="category-btn active" data-category="all">All Posts</button>
                                <button class="category-btn" data-category="destinations">Destinations</button>
                                <button class="category-btn" data-category="tips">Travel Tips</button>
                                <button class="category-btn" data-category="guides">Guides</button>
                                <button class="category-btn" data-category="culture">Culture</button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Blog Posts Grid -->
                    <div class="row g-4 blog-posts-container">
                        <!-- Blog Post Card 1 -->
                        <div class="col-lg-4 col-md-6 blog-post-item" data-category="destinations">
                            <article class="blog-card">
                                <div class="blog-card-image">
                                    <img src="/theme_travelog/static/src/img/banner/Bali-Indonesia.jpg" 
                                         alt="Bali Indonesia" 
                                         class="img-fluid"/>
                                    <div class="blog-card-category">Destinations</div>
                                </div>
                                <div class="blog-card-content">
                                    <div class="blog-card-meta mb-3">
                                        <span class="meta-item">
                                            <i class="fa fa-calendar me-1"></i>
                                            Nov 15, 2024
                                        </span>
                                        <span class="meta-item">
                                            <i class="fa fa-clock me-1"></i>
                                            5 min read
                                        </span>
                                    </div>
                                    <h3 class="blog-card-title">
                                        <a href="/blog/bali-paradise">Discover the Magic of Bali</a>
                                    </h3>
                                    <p class="blog-card-excerpt">
                                        Explore the stunning beaches, ancient temples, and vibrant culture 
                                        of Indonesia's most beloved island paradise.
                                    </p>
                                    <div class="blog-card-footer">
                                        <div class="author-info">
                                            <img src="/theme_travelog/static/src/img/banner/Avatar1.jpeg" 
                                                 alt="Author" 
                                                 class="author-avatar"/>
                                            <span class="author-name">Sarah Johnson</span>
                                        </div>
                                        <a href="/blog" class="read-more-link">
                                            Read More <i class="fa fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                        
                        <!-- Blog Post Card 2 -->
                        <div class="col-lg-4 col-md-6 blog-post-item" data-category="guides">
                            <article class="blog-card">
                                <div class="blog-card-image">
                                    <img src="/theme_travelog/static/src/img/banner/Iceland.jpg" 
                                         alt="Iceland" 
                                         class="img-fluid"/>
                                    <div class="blog-card-category">Guides</div>
                                </div>
                                <div class="blog-card-content">
                                    <div class="blog-card-meta mb-3">
                                        <span class="meta-item">
                                            <i class="fa fa-calendar me-1"></i>
                                            Nov 12, 2024
                                        </span>
                                        <span class="meta-item">
                                            <i class="fa fa-clock me-1"></i>
                                            8 min read
                                        </span>
                                    </div>
                                    <h3 class="blog-card-title">
                                        <a href="/blog/iceland-guide">Complete Guide to Iceland</a>
                                    </h3>
                                    <p class="blog-card-excerpt">
                                        Everything you need to know about visiting Iceland, from the Northern 
                                        Lights to the Blue Lagoon and beyond.
                                    </p>
                                    <div class="blog-card-footer">
                                        <div class="author-info">
                                            <img src="/theme_travelog/static/src/img/banner/Avatar2.jpeg" 
                                                 alt="Author" 
                                                 class="author-avatar"/>
                                            <span class="author-name">Mike Anderson</span>
                                        </div>
                                        <a href="/blog" class="read-more-link">
                                            Read More <i class="fa fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                        
                        <!-- Blog Post Card 3 -->
                        <div class="col-lg-4 col-md-6 blog-post-item" data-category="tips">
                            <article class="blog-card">
                                <div class="blog-card-image">
                                    <img src="/theme_travelog/static/src/img/banner/Santorini Greece.jpg" 
                                         alt="Santorini Greece" 
                                         class="img-fluid"/>
                                    <div class="blog-card-category">Travel Tips</div>
                                </div>
                                <div class="blog-card-content">
                                    <div class="blog-card-meta mb-3">
                                        <span class="meta-item">
                                            <i class="fa fa-calendar me-1"></i>
                                            Nov 10, 2024
                                        </span>
                                        <span class="meta-item">
                                            <i class="fa fa-clock me-1"></i>
                                            6 min read
                                        </span>
                                    </div>
                                    <h3 class="blog-card-title">
                                        <a href="/blog/budget-travel-tips">10 Budget Travel Tips</a>
                                    </h3>
                                    <p class="blog-card-excerpt">
                                        Learn how to travel the world on a budget with these essential 
                                        money-saving tips and tricks.
                                    </p>
                                    <div class="blog-card-footer">
                                        <div class="author-info">
                                            <img src="/theme_travelog/static/src/img/banner/Avatar3.jpeg" 
                                                 alt="Author" 
                                                 class="author-avatar"/>
                                            <span class="author-name">Emma Davis</span>
                                        </div>
                                        <a href="/blog" class="read-more-link">
                                            Read More <i class="fa fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                    
                    <!-- Load More Button -->
                    <div class="row mt-5">
                        <div class="col-12 text-center">
                            <button class="btn btn-outline-primary btn-lg px-5 load-more-btn">
                                <i class="fa fa-refresh me-2"></i>
                                Load More Posts
                            </button>
                        </div>
                    </div>
                </div>
            </section>
        </template>
    </data>
</odoo>
